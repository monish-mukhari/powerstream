generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VideoStatus {
  UPLOADED
  PROCESSING
  READY
  FAILED
}

model Course {
  id          String   @id @default(cuid())
  title       String
  description String
  createdAt   DateTime @default(now())
  videos      Video[]
}

model Video {
  id           String      @id
  courseId     String
  title        String
  position     Int
  status       VideoStatus
  rawKey       String
  hlsPath      String?
  errorMessage String?
  createdAt    DateTime    @default(now())
  course       Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, position])
  @@index([status])
}
