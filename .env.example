# Database and queue (host values used by the Next.js app)
POSTGRES_PORT=5432
DATABASE_URL=postgresql://stream:stream@localhost:5432/streaming?schema=public
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Simple admin authentication
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# S3-compatible storage. These defaults target local MinIO.
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=streaming
S3_FORCE_PATH_STYLE=true

# Playback origin. Production should be a CDN/custom domain.
CDN_BASE_URL=http://localhost:9000/streaming

# Upload limits
MAX_UPLOAD_SIZE_MB=2048
PRESIGNED_URL_TTL_SECONDS=900

# Browser origin used by the bucket CORS policy
APP_ORIGIN=http://localhost:3000
