{
  "name": "reelhouse",
  "private": true,
  "workspaces": [
    "web",
    "worker"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace web",
    "dev:worker": "npm run dev --workspace worker",
    "build": "npm run build --workspace web && npm run build --workspace worker",
    "test": "npm run test --workspace worker",
    "typecheck": "npm run typecheck --workspace web && npm run typecheck --workspace worker",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev"
  },
  "devDependencies": {
    "prisma": "6.19.0"
  }
}
